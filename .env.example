# Bu dosyayı .env.local adıyla kopyala ve değerleri doldur.
# Boş bırakırsan site "önizleme modunda" örnek verilerle çalışır.

# Supabase → Project Settings → API (veya Data API) → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
# Eski projelerde "anon public" anahtarı da çalışır.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Sitenin yayındaki adresi (bağlantı önizlemeleri için). Vercel'de boş bırakılabilir.
NEXT_PUBLIC_SITE_URL=
